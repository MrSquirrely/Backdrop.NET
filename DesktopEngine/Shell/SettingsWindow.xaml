<Window x:Class="Backdrop.NET.Shell.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Backdrop.NET Settings"
        Width="560" Height="620"
        MinWidth="460" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
            <Setter Property="Margin" Value="0,26,0,10"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,18,28,24">

            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}"/>

            <!-- Taskbar -->
            <TextBlock Text="Taskbar" Style="{StaticResource SectionHeader}"/>

            <TextBlock Text="Style" Style="{StaticResource BaseTextBlockStyle}"/>
            <ComboBox x:Name="StyleBox" Width="240" HorizontalAlignment="Left" Margin="0,6,0,0"
                      SelectionChanged="StyleBox_SelectionChanged">
                <ComboBoxItem Content="Standard"/>
                <ComboBoxItem Content="Islands"/>
            </ComboBox>
            <TextBlock x:Name="StyleDescription" Style="{StaticResource Hint}"/>

            <ui:ToggleSwitch x:Name="AutoHideToggle" Header="Automatically hide the bar" Margin="0,18,0,0"
                             Toggled="AutoHideToggle_Toggled"/>
            <TextBlock Style="{StaticResource Hint}"
                       Text="The bar gives its space back to apps and returns when the mouse reaches the bottom edge of the screen."/>

            <!-- Files -->
            <TextBlock Text="Files" Style="{StaticResource SectionHeader}"/>
            <WrapPanel>
                <Button Content="Open settings folder" Margin="0,0,8,8" Click="OpenSettingsFolder_Click"/>
                <Button Content="Open widgets folder" Margin="0,0,8,8" Click="OpenWidgetsFolder_Click"/>
                <Button Content="Open log file" Margin="0,0,8,8" Click="OpenLog_Click"/>
            </WrapPanel>

            <!-- About -->
            <TextBlock Text="About" Style="{StaticResource SectionHeader}"/>
            <TextBlock x:Name="VersionText"/>
            <Button Content="Exit Backdrop.NET" Margin="0,14,0,0" Click="Exit_Click"/>
        </StackPanel>
    </ScrollViewer>
</Window>