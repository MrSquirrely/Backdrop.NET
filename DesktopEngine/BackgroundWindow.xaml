<Window x:Class="Backdrop.NET.BackgroundWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Desktop Engine"
        ShowInTaskbar="False"
        Background="LightSlateGray"
        AllowsTransparency="False"
        ShowActivated="False"
        >
    <Grid>
        <Image x:Name="WallpaperImage" Stretch="UniformToFill" />
        <Canvas x:Name="WidgetCanvas" Background="{x:Null}"/>

        <!-- Only shown while debugging; never takes mouse input away from the widgets -->
        <Border x:Name="DebugWatermark"
                Visibility="Collapsed"
                IsHitTestVisible="False"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#66000000" CornerRadius="12" Padding="32,20">
            <StackPanel>
                <TextBlock Text="DEBUGGING"
                           FontSize="56" FontWeight="Bold" FontFamily="Segoe UI"
                           Foreground="#CCFFFFFF" HorizontalAlignment="Center"/>
                <TextBlock x:Name="DebugWatermarkText"
                           FontSize="18" FontFamily="Consolas"
                           Foreground="#CCFFFFFF" TextAlignment="Center"
                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
